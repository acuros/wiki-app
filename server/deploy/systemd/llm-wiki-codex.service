[Unit]
Description=LLM Wiki Codex app-server

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h
ExecStartPre=/usr/bin/rm -f %t/llm-wiki-codex.sock
ExecStart=/usr/lib/chatgpt/resources/codex app-server --listen unix://%t/llm-wiki-codex.sock
ExecStopPost=/usr/bin/rm -f %t/llm-wiki-codex.sock
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=default.target
